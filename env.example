# ──────────────────────────────────────────────────────────────────────────────
#  Niko — environment template
#
#  Copy this file to `src/.env` (src/bot.py loads that path automatically) or
#  enter the same names in your host's dashboard / secrets manager. Variables
#  marked OPTIONAL may be omitted entirely; the value shown after `=` is the
#  effective default unless noted otherwise.
#
#  Rules of thumb
#    • Empty string  → feature stays off / value is derived at runtime.
#    • Booleans      → true/false (1/0, yes/no, on/off also work).
#    • Never commit a real token, key, or secret.
# ──────────────────────────────────────────────────────────────────────────────


# ── Core ──────────────────────────────────────────────────────────────────────

# REQUIRED. Bot token from Developer Portal → Bot → Reset Token. Without this the
# process exits during startup.
DISCORD_BOT_TOKEN=""

# OPTIONAL. Number of gateway shards. Leave blank to let Discord decide; only set
# it for very large deployments that want a fixed shard count.
SHARD_COUNT=

# OPTIONAL. Forces one command prefix across every server and DM, overriding the
# per-server dashboard and `.prefix` settings. Leave blank to keep per-server
# prefixes.
COMMAND_PREFIX=

# OPTIONAL. Set true on a beta/local instance running next to production: it
# switches to the development status rotation, forces the `!` prefix, and stops
# XP and message-activity writes so live data cannot be overwritten.
DEVELOPMENT=false

# OPTIONAL, legacy. Adds an extra log line when the AI produces an empty reply.
# Use LOG_LEVEL=DEBUG for real diagnostics instead.
DEBUG_MODE=false

# OPTIONAL. Replaces the rotating bot status with one fixed message.
STATUS_MESSAGE=


# ── Dashboard, OAuth and public links ─────────────────────────────────────────

# OPTIONAL. OAuth application id. Blank uses Niko's public application id.
DISCORD_CLIENT_ID=

# REQUIRED for dashboard login. OAuth2 client secret from the Developer Portal.
DISCORD_CLIENT_SECRET=""

# OPTIONAL. Explicit OAuth callback. Blank derives
# <PUBLIC_URL>/auth/callback (or the Replit/host origin).
DISCORD_REDIRECT_URI=

# OPTIONAL but strongly recommended. Canonical public origin, e.g.
# https://niko.sryze.cc. Used for OAuth redirects, payment provider callbacks,
# transcript links, verification links and every URL the bot sends in Discord.
# On Replit it falls back to the injected REPLIT_DEV_DOMAIN; everything else
# falls back to the request host.
PUBLIC_URL=

# REQUIRED in practice. Signs dashboard sessions and donation links. Use a long
# random string; changing it signs every dashboard user out.
SESSION_SECRET=""

# OPTIONAL. HTTP port for the web/dashboard process. Most hosts inject this;
# local runs default to 5000.
PORT=5000


# ── Interactions endpoint (OPTIONAL) ──────────────────────────────────────────
# Only needed when Discord POSTs interactions to your own HTTPS endpoint instead
# of delivering them over the gateway. See docs/setup.md.

# OPTIONAL. Application public key. When unset the key is read once from the
# Discord application object at startup.
DISCORD_PUBLIC_KEY=

# OPTIONAL. Seconds to wait for a handler before answering Discord with 202.
DISCORD_INTERACTION_BUDGET_SECONDS=2.0


# ── Storage ───────────────────────────────────────────────────────────────────

# OPTIONAL. MongoDB connection string, e.g. mongodb://localhost:27017. Leave
# blank to use the local SQLite database in data/.
MONGODB_URL=

# OPTIONAL. MongoDB database name used when MONGODB_URL is set.
MONGODB_DATABASE=discord_bot


# ── AI chat ───────────────────────────────────────────────────────────────────

# REQUIRED for AI replies and the AI action system.
GROQ_API_KEY=""

# OPTIONAL. Alternate OpenAI-compatible base URL (defaults to Groq's endpoint).
GROQ_BASE_URL=

# OPTIONAL. Reasoning effort for thinking models: low, medium or high.
GROQ_REASONING_EFFORT=

# OPTIONAL. Master kill switch. Set false to disable every AI reply without
# removing the key.
AI_ENABLED=true

# OPTIONAL. Model name shown in /systeminfo. Purely informational.
AI_MODEL=

# OPTIONAL. Channel id that receives AI error reports with "AI Debug" and
# "Fix with AI" buttons.
AI_DEBUG_CHANNEL=

# OPTIONAL. Separate OpenAI-compatible key/base for the AI debugging tool. Blank
# disables the AI analysis buttons (reports are still posted).
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=


# ── Images ────────────────────────────────────────────────────────────────────

# REQUIRED for premium image moderation. fal.ai key used by the NSFW image
# filter, a premium perk. `FAL_API_KEY` is accepted as an alias for this name.
FAL_KEY=

# OPTIONAL. Overrides for the NSFW model endpoint and its confidence threshold.
# Images scoring at or above the threshold are removed.
FAL_NSFW_URL=
NSFW_THRESHOLD=0.85

# OPTIONAL. Hugging Face token for the AI image tools. Those tools are currently
# disabled, so this only matters once they return.
HUGGINGFACE_API_KEY=


# ── Payments (premium and donations) ──────────────────────────────────────────

# REQUIRED for checkout. OxaPay *Merchant* API key — not the sandbox key and not
# the payout key. Powers both premium and /donate, and signs the webhooks.
OXAPAY_API_KEY=""

# OPTIONAL. Signs `/donate` links. Blank falls back to SESSION_SECRET, then to
# DISCORD_BOT_TOKEN. Set it explicitly if you rotate the bot token.
DONATION_TOKEN_SECRET=

# OPTIONAL. Monthly running-cost goal in USD. When set, /billing shows a donation
# progress bar. Leave blank to hide it.
DONATION_GOAL_USD=


# ── Logging ───────────────────────────────────────────────────────────────────

# OPTIONAL. Discord webhook URL for the error/status feed. Off when blank; a
# single network outage can otherwise produce a rate-limited error loop.
LOGGING_WEBHOOK=

# OPTIONAL. DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=logs/niko.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3


# ── Music and the social notifier ─────────────────────────────────────────────

# OPTIONAL. Spotify credentials for the music cog and profile cards.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OPTIONAL. Last.fm key; required for music autoplay.
LASTFM_API_KEY=

# OPTIONAL. Twitch credentials for notifier tracking and Twitch profile cards.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# ── Leveling imports ─────────────────────────────────────────────────────────

# OPTIONAL. AmariBot API key. When set, servers that run AmariBot are offered a
# one-click import of their levels in the join DM. AmariBot only issues keys to
# approved API applicants, and one key covers every server the bot is in.
AMARIBOT_API_KEY=


# ── Voting ────────────────────────────────────────────────────────────────────

# OPTIONAL. top.gg listing id. Blank uses Niko's listing.
TOPGG_BOT_ID=

# OPTIONAL. top.gg webhook token. Required to credit vote rewards (coins, streaks,
# vote badges) and send the thank-you DM.
TOPGG_WEBHOOK_TOKEN=


# ── Networking and resilience ─────────────────────────────────────────────────

# OPTIONAL. Webshare key for rotating outbound proxies. Useful on shared hosts
# that get globally rate limited by Discord.
WEBSHARE_API_KEY=

# OPTIONAL. Shared secret for Discord API proxy workers; must match each
# worker's AUTH_TOKEN. Requires MONGODB_URL.
PROXY_WORKER_TOKEN=


# ── Verification page ad slot (OPTIONAL) ──────────────────────────────────────

# OPTIONAL. Numeric AADS unit id. The ad slot is omitted when unset.
AADS_AD_UNIT_ID=


# ── Cooldowns (OPTIONAL, seconds) ─────────────────────────────────────────────

# One AI image per user per this many seconds. The free image provider is shared,
# so this cannot be disabled — only tuned down, to a floor of 1 second.
IMAGE_GEN_COOLDOWN=30

# Casino cooldowns. Each game allows one play per this many seconds.
SLOTS_COOLDOWN=30
BLACKJACK_COOLDOWN=30
ROULETTE_COOLDOWN=30
