# ──────────────────────────────────────────────────────────────────────────────
#  Niko — environment template
#
#  Copy this file to `src/.env` (src/bot.py loads that path automatically) or
#  enter the same names in your host's dashboard / secrets manager. Variables
#  marked OPTIONAL may be omitted entirely; the value shown after `=` is the
#  effective default unless noted otherwise.
#
#  Rules of thumb
#    • Empty string  → feature stays off / value is derived at runtime.
#    • Booleans      → true/false (1/0, yes/no, on/off also work).
#    • Never commit a real token, key, or secret.
# ──────────────────────────────────────────────────────────────────────────────


# ── Core ──────────────────────────────────────────────────────────────────────

# REQUIRED. Bot token from Developer Portal → Bot → Reset Token. Without this the
# process exits during startup.
DISCORD_BOT_TOKEN=""

# OPTIONAL. Number of gateway shards. Leave blank to let Discord decide; only set
# it for very large deployments that want a fixed shard count.
SHARD_COUNT=

# OPTIONAL. Forces one command prefix across every server and DM, overriding the
# per-server dashboard and `.prefix` settings. Leave blank to keep per-server
# prefixes.
COMMAND_PREFIX=

# OPTIONAL. Set true on a beta/local instance running next to production: it
# switches to the development status rotation, forces the `!` prefix, and stops
# XP and message-activity writes so live data cannot be overwritten.
DEVELOPMENT=false

# OPTIONAL, legacy. Adds an extra log line when the AI produces an empty reply.
# Use LOG_LEVEL=DEBUG for real diagnostics instead.
DEBUG_MODE=false

# OPTIONAL. Replaces the rotating bot status with one fixed message.
STATUS_MESSAGE=


# ── Dashboard, OAuth and public links ─────────────────────────────────────────

# OPTIONAL. OAuth application id. Blank uses Niko's public application id.
DISCORD_CLIENT_ID=

# REQUIRED for dashboard login. OAuth2 client secret from the Developer Portal.
DISCORD_CLIENT_SECRET=""

# OPTIONAL. Explicit OAuth callback. Blank derives
# <PUBLIC_URL>/auth/callback (or the Replit/host origin).
DISCORD_REDIRECT_URI=

# OPTIONAL but strongly recommended. Canonical public origin, e.g.
# https://niko.sryze.cc. Used for OAuth redirects, payment provider callbacks,
# transcript links, verification links and every URL the bot sends in Discord.
# On Replit it falls back to the injected REPLIT_DEV_DOMAIN; everything else
# falls back to the request host.
PUBLIC_URL=

# REQUIRED in practice. Signs dashboard sessions and donation links. Use a long
# random string; changing it signs every dashboard user out.
SESSION_SECRET=""

# OPTIONAL. Serve the dashboard from its own subdomain instead of the
# /dashboard path: with a wildcard DNS record (and a certificate covering it)
# for your domain, https://dash.example.com/staff is
# https://example.com/dashboard/staff and https://dash.example.com/ is the
# dashboard home. Sign-ins are shared across the domain by setting the session
# cookie on <PUBLIC_URL's domain>, and any other host under that domain answers
# with the 404 page instead of the site — set PUBLIC_URL to your canonical apex
# for both. Blank/false keeps every URL on the apex.
# See "Dashboard on a subdomain" in docs/dashboard.md.
SUBDOMAIN_ROUTING=false

# OPTIONAL. HTTP port for the web/dashboard process. Most hosts inject this;
# local runs default to 5000.
PORT=5000

# OPTIONAL. Origin of the beta instance this deployment reads from, e.g.
# https://beta.example.com. Set it on production only. Two things use it:
#   • translations — the site serves beta's catalogues and /status counts them
#     while they are being written (see web/src/locales/README.md)
#   • updates — the owner's Updates tab pulls changed files from beta and
#     applies them area by area (see docs/updates.md)
# Empty keeps this instance entirely on its own files.
BETA_INSTANCE_URL=

# OPTIONAL. Seconds a beta translation manifest is reused before it is read
# again (default 15). This is how far behind beta the live site can be.
LOCALE_FEED_TTL=

# REQUIRED for updates. Shared secret between beta and production: beta only
# serves its source files (GET /api/updates/manifest.json and /api/updates/file)
# to a caller that sends the same value in X-Update-Token. It also authorizes
# the recovery path: beta can POST /supervisor/update to production with this
# token, and production's supervisor accepts it even when the dashboard is down.
# Generate it with `python3 -c "import secrets; print(secrets.token_hex(32))"`
# and set the same value on both instances. Empty disables updates entirely.
BETA_UPDATE_TOKEN=

# OPTIONAL, beta only. Origin of the production instance, e.g.
# `https://niko.example.com`. Enables `POST /api/updates/push` on beta so the
# owner can force production to apply an update while production's dashboard is
# unreachable. The request carries BETA_UPDATE_TOKEN; nothing in the body can
# redirect it to another host.
PRODUCTION_INSTANCE_URL=


# ── Interactions endpoint (OPTIONAL) ──────────────────────────────────────────
# Only needed when Discord POSTs interactions to your own HTTPS endpoint instead
# of delivering them over the gateway. See docs/setup.md.

# OPTIONAL. Application public key. When unset the key is read once from the
# Discord application object at startup.
DISCORD_PUBLIC_KEY=

# OPTIONAL. Seconds to wait for a handler before answering Discord with 202.
DISCORD_INTERACTION_BUDGET_SECONDS=2.0


# ── Storage ───────────────────────────────────────────────────────────────────

# OPTIONAL. MongoDB connection string, e.g. mongodb://localhost:27017. Leave
# blank to use the local SQLite database in data/.
MONGODB_URL=

# OPTIONAL. MongoDB database name used when MONGODB_URL is set. Isolated
# stores derive their own names from it: <name>_music, <name>_error_reports and
# <name>_developer_portal. They are separate databases, not collections in this
# one, so they never add tables to the primary database.
MONGODB_DATABASE=discord_bot


# ── AI chat ───────────────────────────────────────────────────────────────────

# REQUIRED for AI replies and the AI action system.
GROQ_API_KEY=""

# OPTIONAL. Alternate OpenAI-compatible base URL (defaults to Groq's endpoint).
GROQ_BASE_URL=

# OPTIONAL. Reasoning effort for thinking models: low, medium or high.
GROQ_REASONING_EFFORT=

# OPTIONAL. Master kill switch. Set false to disable every AI reply without
# removing the key.
AI_ENABLED=true

# OPTIONAL. Model name shown in /systeminfo. Purely informational.
AI_MODEL=

# OPTIONAL. Channel id that receives AI error reports with "AI Debug" and
# "Fix with AI" buttons.
AI_DEBUG_CHANNEL=

# OPTIONAL. Separate OpenAI-compatible key/base for the AI debugging tool. Blank
# disables the AI analysis buttons (reports are still posted).
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=


# ── Images ────────────────────────────────────────────────────────────────────

# REQUIRED for premium image moderation. fal.ai key used by the NSFW image
# filter, a premium perk. `FAL_API_KEY` is accepted as an alias for this name.
FAL_KEY=

# OPTIONAL. Overrides for the NSFW model endpoint and its confidence threshold.
# Images scoring at or above the threshold are removed.
FAL_NSFW_URL=
NSFW_THRESHOLD=0.85

# OPTIONAL. Hugging Face token for the AI image tools. Those tools are currently
# disabled, so this only matters once they return.
HUGGINGFACE_API_KEY=


# ── Payments (premium and donations) ──────────────────────────────────────────

# REQUIRED for checkout. OxaPay *Merchant* API key — not the sandbox key and not
# the payout key. Powers both premium and /donate, and signs the webhooks.
OXAPAY_API_KEY=""

# OPTIONAL. Signs `/donate` links. Blank falls back to SESSION_SECRET, then to
# DISCORD_BOT_TOKEN. Set it explicitly if you rotate the bot token.
DONATION_TOKEN_SECRET=

# OPTIONAL. Monthly running-cost goal in USD. When set, /billing shows a donation
# progress bar. Leave blank to hide it.
DONATION_GOAL_USD=


# ── Staff mailbox (OPTIONAL) ─────────────────────────────────────────────────
# The hidden staff email page stays off until the provider key is set. Its
# addresses live on the site's own domain: owner@ for the owner, admin@ for the
# owner and Head Admins, support@ for the support team, support-lead@ for the
# head of support, and a private <discord-username>@ address for every staff
# member, minted automatically and shown under their Discord display name. On
# Mailgun: add the domain, publish its DNS records (TXT for sending, MX for
# receiving), then add a receive route whose action forwards to
# <PUBLIC_URL>/api/staff/email/inbound.
#
# A personal address follows the staff record: suspending or removing a member
# makes their address answer with a note that it can no longer receive mail and
# that senders should write to support@, and a Discord rename moves the address
# while the old one keeps pointing at the new one for 30 days.
#
# Delivery events go to a second webhook, <PUBLIC_URL>/api/staff/email/events:
# add it for every event type (delivered, opened, clicked, permanent_fail,
# temporary_fail, complained, unsubscribed, stored). `opened` is the read
# receipt the page shows, so enable open tracking on the domain as well.
MAILGUN_API_KEY=

# NEEDED TO RECEIVE. The account's HTTP webhook signing key (Settings →
# API Security → HTTP webhook signing key), not the API key. Every route
# delivery is signed with it and the endpoint rejects what it cannot verify.
MAILGUN_WEBHOOK_SIGNING_KEY=

# OPTIONAL. Set to `eu` when the domain lives on Mailgun's EU host; blank is US.
MAILGUN_REGION=

# OPTIONAL. Domain the addresses use. Blank uses the PUBLIC_URL host, which is
# niko.sryze.cc in production and the current host in a sandbox.
STAFF_EMAIL_DOMAIN=

# OPTIONAL. Display name on outgoing mail, e.g. "Niko Owner <owner@…>".
STAFF_EMAIL_FROM_NAME=Niko


# ── Logging ───────────────────────────────────────────────────────────────────

# OPTIONAL. Discord webhook URL for the error/status feed. Off when blank; a
# single network outage can otherwise produce a rate-limited error loop.
LOGGING_WEBHOOK=

# OPTIONAL. DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=logs/niko.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3


# ── Music and the social notifier ─────────────────────────────────────────────

# OPTIONAL. Spotify Web API credentials for the music cog. Spotify links resolve
# without them through the public embed page; with them the Web API is tried
# first (tracks/albums) and the embed page is the fallback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OPTIONAL. Experimental: adds an "Open Player" button to the now-playing panel
# that launches this application's Discord Activity in the voice channel. The
# app must have Activities enabled and the root URL mapping described in
# docs/music-activity.md in the Developer Portal; Discord rejects the launch
# callback otherwise.
MUSIC_ACTIVITY_ENABLED=false

# OPTIONAL. Subdomain that serves the Activity at its root. Discord's URL
# mapping always uses the root prefix, so the panel cannot live under a path.
# Defaults to `activities`, i.e. https://activities.<PUBLIC_URL host>/. Point
# the wildcard DNS record you already have at this service; no extra route is
# needed. Set this to the same label you enter in the URL mapping.
MUSIC_ACTIVITY_SUBDOMAIN=activities

# OPTIONAL. Full public origin of the Activity when it is not the subdomain
# above (a separate host, or a tunnel such as https://abc.trycloudflare.com for
# local testing). When empty it is derived from PUBLIC_URL and the subdomain.
MUSIC_ACTIVITY_ORIGIN=

# OPTIONAL. Last.fm key; required for music autoplay.
LASTFM_API_KEY=
# Shared secret for last.fm's web auth. Only needed for the website's "Connect
# Last.fm" flow (/api/lastfm/link); set the callback URI on the last.fm API
# application to https://<your site>/api/lastfm/callback.
LASTFM_API_SECRET=
# Optional override when the callback must differ from PUBLIC_URL.
LASTFM_REDIRECT_URI=

# OPTIONAL. Twitch credentials for notifier tracking and Twitch profile cards.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# ── Leveling imports ─────────────────────────────────────────────────────────

# OPTIONAL. AmariBot API key. When set, servers that run AmariBot are offered a
# one-click import of their levels in the join DM. AmariBot only issues keys to
# approved API applicants, and one key covers every server the bot is in.
AMARIBOT_API_KEY=


# ── Voting ────────────────────────────────────────────────────────────────────

# OPTIONAL. top.gg listing id. Blank uses Niko's listing.
TOPGG_BOT_ID=

# OPTIONAL. top.gg webhook token. Required to credit vote rewards (coins, streaks,
# vote badges) and send the thank-you DM.
TOPGG_WEBHOOK_TOKEN=


# ── Networking and resilience ─────────────────────────────────────────────────

# OPTIONAL. Webshare key for rotating outbound proxies. Useful on shared hosts
# that get globally rate limited by Discord.
WEBSHARE_API_KEY=

# OPTIONAL. Shared secret for Discord API proxy workers; must match each
# worker's AUTH_TOKEN. Requires MONGODB_URL.
PROXY_WORKER_TOKEN=


# ── Verification page ad slot (OPTIONAL) ──────────────────────────────────────

# OPTIONAL. Numeric AADS unit id. The ad slot is omitted when unset.
AADS_AD_UNIT_ID=


# ── Supervisor (OPTIONAL, supervised deployments only) ────────────────────────

# Refuse to fall back to local SQLite when MongoDB is missing or unreachable.
# Set this on supervised staging/production so an outage cannot silently start
# the bot on an empty database. Leave blank for local development.
NIKO_STRICT_DB=

# Critical cogs and startup steps for supervised readiness. Comma-separated;
# blank uses the defaults (cogs.system,cogs.admin,cogs.utility and
# init_database,load_cogs,preload_economy_cache).
NIKO_CRITICAL_COGS=
NIKO_CRITICAL_STARTUP_STEPS=

# Seconds between a bot-area update marking its restore point and the
# supervisor stopping the child. Gives the update response time to flush.
NIKO_SUPERVISED_RESTART_DELAY=2.0

# Run the dashboard and the bot as separate supervised children. This is the
# default: the dashboard is the public child and live-bot API routes are
# bridged to the bot child over loopback. Set 0 for the combined child.
NIKO_SPLIT_WEB=

# Run the database pool in its own supervised child (src/db_child.py). This is
# the default whenever the dashboard and bot are split; the bot reaches it over
# an authenticated loopback API. Set 0 to keep the pool in the bot child.
NIKO_SPLIT_DB=

# Owner log archive. Every process writes its own directory, split by level
# (<archive>/<process>/<LEVEL>.jsonl), so each buffer is independent. The
# supervisor sets these for its children; only set them by hand when starting a
# child outside the supervisor. NIKO_LOG_STORE is the archive *directory*.
NIKO_LOG_STORE=
NIKO_LOG_STORE_BYTES=
NIKO_LOG_STORE_BACKUPS=


# ── Cooldowns (OPTIONAL, seconds) ─────────────────────────────────────────────

# One AI image per user per this many seconds. The free image provider is shared,
# so this cannot be disabled — only tuned down, to a floor of 1 second.
IMAGE_GEN_COOLDOWN=30

# Casino cooldowns. Each game allows one play per this many seconds.
SLOTS_COOLDOWN=30
BLACKJACK_COOLDOWN=30
ROULETTE_COOLDOWN=30
