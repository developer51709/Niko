    "@vitejs/plugin-react": "^4.7.0",
    "fontkit": "^2.0.4",
    "lucide-react": "^1.39.0",
    "motion": "^13.4.1",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@web3icons/core": "^4.0.58",
