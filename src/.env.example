DISCORD_BOT_TOKEN="the bot token goes here" # Required (The bot will not work without this)
DISCORD_CLIENT_ID="" # The Discord oauth logins will not work without this
DISCORD_CLIENT_SECRET="" # Required for Discord OAuth dashboard login
DISCORD_REDIRECT_URI="https://niko.sryze.cc/auth/callback"
DEBUG_MODE="False" # Change to True to enable more detailed logging (Deprecated)
DONATION_SITE_URL="https://niko.sryze.cc"
SHARD_COUNT="" # Optional, leave blank to disable sharding
GROQ_API_KEY="" # Required for the AI features
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_CLIENT_ID=""
LASTFM_API_KEY="" # Optional but required for the music cogs autoplay feature
AI_DEBUG_CHANNEL="" # Optional but makes debugging easier by adding AI powered error reports and quick AI powered fixes for smaller issues (exerimental)
LOGGING_WEBHOOK="" # Optional (Not recommended because a single internet issue will cause an infinite error loop resulting in rate limits)
OXAPAY_API_KEY="" # Required for the donation command to work, use the **Merchant Key** not the General or Payout keys
PUBLIC_URL="https://niko.sryze.cc"
MONGODB_URL="" # Optional: MongoDB connection string (e.g., mongodb://localhost:27017). If set, MongoDB will be used instead of SQLite
MONGODB_DATABASE="discord_bot" # Optional: MongoDB database name (default: discord_bot)
WEBSHARE_API_KEY="" # Optional (Adds an automated proxy fallback since shared hosting such as render gets global rate limited a lot causing excessive downtime)
